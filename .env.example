# ResearchLens AI — copy to .env.local and fill in. Never commit real values.

# Supabase (public, browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase (server only — never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=research-papers

# Optional: only needed to apply migrations from your machine (psql / Supabase CLI)
DATABASE_URL=

# AI providers (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
